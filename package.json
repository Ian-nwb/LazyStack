{
  "name": "lazystack",
  "version": "1.0.5",
  "description": "Automated Tech Stack & Monorepo Boilerplate Generator",
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "lazystack": "./bin/lazystack.js"
  },
  "scripts": {
    "dev": "vite",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=packages/cli/dist/cli.js --packages=external",
    "build": "vite build && npm run build:cli",
    "preview": "vite preview",
    "precli": "npm run build:cli",
    "cli": "node ./bin/lazystack.js",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage --config.directories.output=release/1.0.5",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win portable --config.directories.output=release/1.0.5",
    "dist:release": "npm run build && electron-builder --linux AppImage --win portable --config.directories.output=release/1.0.5"
  },
  "keywords": [
    "electron",
    "monorepo",
    "scaffolding",
    "docker",
    "devops",
    "assembly",
    "drogon"
  ],
  "author": {
    "name": "LazyStack Team",
    "email": "team@lazystack.dev"
  },
  "homepage": "https://github.com/lazystack/lazystack",
  "license": "MIT",
  "build": {
    "appId": "com.lazystack.app",
    "productName": "LazyStack",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "LazyStack Team <team@lazystack.dev>"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "detect-port": "^2.1.0",
    "fs-extra": "^11.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@types/detect-port": "^1.3.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
