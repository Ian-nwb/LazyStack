{
  "name": "lazystack",
  "version": "1.2.0",
  "description": "Desktop app and CLI that scaffolds polyglot projects: 87 frameworks, 25 databases, Docker Compose, reverse proxy and a dev orchestrator from one blueprint.",
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "lazystack": "./bin/lazystack.js"
  },
  "scripts": {
    "dev": "vite",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=packages/cli/dist/cli.js --packages=external",
    "build": "vite build && npm run build:cli",
    "preview": "vite preview",
    "precli": "npm run build:cli",
    "cli": "node ./bin/lazystack.js",
    "verify:layout": "esbuild scripts/verify-layout.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-scripts/verify-layout.mjs --log-level=warning && node dist-scripts/verify-layout.mjs",
    "verify:templates": "esbuild scripts/verify-templates.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-scripts/verify-templates.mjs --log-level=warning && node dist-scripts/verify-templates.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:release": "npm run build && electron-builder --linux AppImage --win portable"
  },
  "keywords": [
    "electron",
    "monorepo",
    "scaffolding",
    "docker",
    "devops",
    "project-generator",
    "polyglot",
    "docker-compose",
    "boilerplate",
    "cli"
  ],
  "author": {
    "name": "Ian-nwb",
    "url": "https://github.com/Ian-nwb"
  },
  "homepage": "https://github.com/Ian-nwb/LazyStack#readme",
  "license": "MIT",
  "build": {
    "appId": "com.lazystack.app",
    "productName": "LazyStack",
    "icon": "build/icon.png",
    "directories": {
      "output": "release/1.2.0"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Ian-nwb (https://github.com/Ian-nwb)"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "detect-port": "^2.1.0",
    "fs-extra": "^11.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@types/detect-port": "^1.3.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ian-nwb/LazyStack.git"
  },
  "bugs": {
    "url": "https://github.com/Ian-nwb/LazyStack/issues"
  }
}
